    given-names: "Wei"
    affiliation: "Xi'an Children's Hospital"
repository-code: "https://github.com/YUWUxagw/armd-transferability-audit"
# TODO: add doi once the release is deposited on Zenodo
# doi: "10.5281/zenodo.XXXXXXX"
keywords:
  - antimicrobial resistance
  - Pseudomonas aeruginosa
  - external validation
  - transportability
  - distribution shift
  - electronic health records
  - clinical prediction model
references:
